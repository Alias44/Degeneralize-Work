<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/StatDef[defName="VSE_WeaponCreationSpeed" or defName="VSE_ComponentCraftingSpeed"]/statFactors/li/text()["GeneralLaborSpeed"]</xpath>
		<value>SmithingSpeed</value>
	</Operation>

	<Operation Class="DegeneralizeWork.PatchOperationModSequence">
		<patchModes>
			<vanillaexpanded.skills>LightTouch</vanillaexpanded.skills>
		</patchModes>
		<operations>
			<li Class="PatchOperationReplace">
				<xpath>Defs/StatDef[defName="VSE_ArtSpeed"]/statFactors/li/text()["GeneralLaborSpeed"]</xpath>
				<value>SculptingSpeed</value>
			</li>
			<li Class="PatchOperationReplace">
				<xpath>Defs/StatDef[defName="VSE_TailoringSpeed"]/statFactors/li/text()["GeneralLaborSpeed"]</xpath>
				<value>TailoringSpeed</value>
			</li>
		</operations>
	</Operation>
	
	<Operation Class="DegeneralizeWork.PatchOperationModSequence">
		<patchModes>
			<vanillaexpanded.skills>BestGuess</vanillaexpanded.skills>
			<!--<vanillaexpanded.skills>HeavyHand</vanillaexpanded.skills>-->
		</patchModes>
		<operations>
			<li Class="PatchOperationRemove">
				<xpath>Defs/StatDef[defName="VSE_TailoringSpeed" or defName="VSE_ArtSpeed"]</xpath>
			</li>
		</operations>
	</Operation>
	
	<Operation Class="DegeneralizeWork.PatchOperationModSequence">
		<patchModes>
			<vanillaexpanded.skills>BestGuess</vanillaexpanded.skills>
		</patchModes>
		<operations>
			<li Class="PatchOperationSetName">
				<xpath>Defs/VSE.Expertise.ExpertiseDef/statOffsets/VSE_ArtSpeed</xpath>
				<name>SculptingSpeed</name>
			</li>
			<li Class="PatchOperationSetName">
				<xpath>Defs/VSE.Expertise.ExpertiseDef/statOffsets/VSE_TailoringSpeed</xpath>
				<name>TailoringSpeed</name>
			</li>
		</operations>
	</Operation>
	
	<!-- dev note: <xpath>///li/text()[. = "VSE_ArtSpeed"]</xpath> might work for older style li based defs, but is exceedingly slow -->
